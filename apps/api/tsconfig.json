{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": ".",
    "outDir": "dist"
    // Sin alias a `packages/contracts/src`: la API consume el paquete COMPILADO,
    // igual que lo haría cualquier otro consumidor de la API (Principio I).
    // Si el alias apuntara al fuente, el paquete quedaría fuera de `rootDir` y,
    // peor, nunca probaríamos lo que realmente publicamos.
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "drizzle.config.ts"]
}
