# Copiar a .env — NUNCA commitear secretos reales (Constitución, Principio V)

# --- Base de datos ---
DATABASE_URL=postgres://cci:cci_local@localhost:5432/cci
# Rol de la aplicación: sin UPDATE/DELETE sobre el libro (migración 0004)
DATABASE_APP_ROLE=app_role

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=cambiar-en-cada-entorno-min-32-caracteres

# --- Proveedores externos (opcionales: sin ellos, el MVP arranca en modo simulado) ---
# Voz — Deepgram Flux Multilingual (D-06). D-07-A: el token efímero se emite desde la API.
PROVEEDOR_VOZ=simulado          # simulado | deepgram
DEEPGRAM_API_KEY=

# Interpretación — claude-opus-5 vía OpenRouter (D-09). Solo el ~10% de excepciones.
PROVEEDOR_INTERPRETACION=simulado   # simulado | openrouter
OPENROUTER_API_KEY=

# ERP — Oracle Fusion Cloud Inventory Management (D-24)
PROVEEDOR_ERP=simulado          # simulado | oracle
ORACLE_FUSION_BASE_URL=
ORACLE_FUSION_USER=
ORACLE_FUSION_PASSWORD=

# --- Observabilidad (D-23) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cci-api
